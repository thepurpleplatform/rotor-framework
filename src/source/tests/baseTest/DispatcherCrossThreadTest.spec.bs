import "pkg:/source/base/DispatcherCrossThread.bs"
import "pkg:/source/engine/Constants.bs"

namespace tests

    @suite("DispatcherCrossThread behaviour")
    class DispatcherCrossThreadSuite extends rooibos.BaseTestSuite

        frameworkStub as object
        deregisteredId as string
        addedObservers as object
        removedObservers as object
        relayedIntents as object

        protected override function beforeEach()
            m.addedObservers = []
            m.removedObservers = []
            m.relayedIntents = []
            m.deregisteredId = ""

            m.frameworkStub = {
                addedObservers: m.addedObservers,
                removedObservers: m.removedObservers,
                relayedIntents: m.relayedIntents,
                addObserver: sub(fieldId, node)
                    m.addedObservers.push({ fieldId: fieldId, node: node })
                end sub,
                removeObserver: sub(fieldId, node)
                    m.removedObservers.push({ fieldId: fieldId, node: node })
                end sub,
                ' Thread-neutral router entry point. Records every relayed intent so
                ' both dispatch directions can be asserted, and mimics the render-side
                ' Framework by serializing onto the node's rotorSync field when present.
                sendIntent: sub(node, dispatcherId, intent)
                    m.relayedIntents.push({ dispatcherId: dispatcherId, intent: intent })
                    if node <> invalid and node.hasField("rotorSync")
                        node.setField("rotorSync", {
                            type: Rotor.Const.ThreadSyncType.DISPATCH,
                            payload: { dispatcherId: dispatcherId, intent: intent }
                        })
                    end if
                end sub,
                dispatcherProvider: {
                    mockDispatchers: {},
                    testSuite: m,
                    deregisterDispatcher: sub(id)
                        m.testSuite.deregisteredId = id
                    end sub,
                    get: function(id)
                        return m.mockDispatchers[id]
                    end function
                }
            }

            GetGlobalAA().rotor_framework_helper = {
                frameworkInstance: m.frameworkStub
            }
        end function

   		@describe("dispatch cross-thread intent serialization")

        @it("dispatch serializes intent onto task node for render thread")
        function dispatch_sets_rotor_sync_payload()
            node = CreateObject("roSGNode", "ContentNode")
            node.addField("rotorSync", "assocarray", true)
            dispatcher = new Rotor.DispatcherCrossThread("renderDispatch", node, Rotor.Const.ThreadType.RENDER)

            dispatcher.dispatch({ type: "PING", payload: {} } as Intent)

            payload = node.getField("rotorSync")
            m.assertEqual(payload.type, Rotor.Const.ThreadSyncType.DISPATCH)
            m.assertEqual(payload.payload.dispatcherId, "renderDispatch")
        end function

        @it("dispatch from a TASK-thread dispatcher relays through the framework router (task → render)")
        function dispatch_from_task_thread_relays_via_router()
            ' Regression guard: a task-thread cross-thread dispatcher used to call a
            ' render-only router method that does not exist on the task framework,
            ' crashing mid-reduce. dispatch() must instead delegate to the shared,
            ' thread-neutral sendIntent so the task → render (and task → task) leg works.
            node = CreateObject("roSGNode", "ContentNode")
            dispatcher = new Rotor.DispatcherCrossThread("layout", node, Rotor.Const.ThreadType.TASK)

            dispatcher.dispatch({ type: "SHOW_TOAST", payload: { text: "hi" } } as Intent)

            m.assertEqual(m.relayedIntents.Count(), 1)
            m.assertEqual(m.relayedIntents[0].dispatcherId, "layout")
            m.assertEqual(m.relayedIntents[0].intent.type, "SHOW_TOAST")
        end function

        @it("dispatch surfaces a loud error instead of crashing when the router method is missing")
        function dispatch_handles_missing_router_method()
            ' Hardening: if the framework router lacks sendIntent, dispatch must return
            ' gracefully (loud error) rather than throw and strand the caller's cycle.
            GetGlobalAA().rotor_framework_helper = { frameworkInstance: {} }
            node = CreateObject("roSGNode", "ContentNode")
            dispatcher = new Rotor.DispatcherCrossThread("orphan", node, Rotor.Const.ThreadType.TASK)

            dispatcher.dispatch({ type: "PING", payload: {} } as Intent)

            m.assertEqual(m.relayedIntents.Count(), 0) ' nothing relayed, no throw
        end function

        @it("addListener on render thread stores listener without setting up observer")
        function render_thread_add_remove_listener_no_observer()
            node = CreateObject("roSGNode", "ContentNode")
            node.addField("rotorSync", "assocarray", true)
            dispatcher = new Rotor.DispatcherCrossThread("renderListener", node, Rotor.Const.ThreadType.RENDER)

            dispatcher.addListener({}, "listener-1", { props: {} })
            m.assertFalse(dispatcher.isStateObserved) ' notifications come via RotorFramework AddMessageHandler
            m.assertEqual(dispatcher.listeners.Count(), 1)

            dispatcher.removeAllListenersByListenerId("listener-1")
            m.assertEqual(dispatcher.listeners.Count(), 0)
        end function

        @it("task thread listeners delegate to framework observer hooks")
        function task_thread_add_remove_listener_delegates_to_framework()
            node = CreateObject("roSGNode", "ContentNode")
            node.addField("rotorSync", "assocarray", true)
            dispatcher = new Rotor.DispatcherCrossThread("taskListener", node, Rotor.Const.ThreadType.TASK)

            dispatcher.addListener({}, "listener-2", { props: {} })
            m.assertEqual(m.addedObservers.Count(), 1)
            m.assertTrue(dispatcher.isStateObserved)

            dispatcher.removeAllListenersByListenerId("listener-2")
            m.assertEqual(m.removedObservers.Count(), 1)
            m.assertFalse(dispatcher.isStateObserved)
        end function

        @it("getState returns field and runs optional mapper")
        function getState_returns_state_and_runs_map()
            node = CreateObject("roSGNode", "ContentNode")
            node.addField("taskDispatcher", "assocarray", true)
            node.setField("taskDispatcher", { count: 5 })
            dispatcher = new Rotor.DispatcherCrossThread("taskDispatcher", node, Rotor.Const.ThreadType.RENDER)
            scope = { props: { count: 0 } }

            state = dispatcher.getState(sub(props, newState)
                props.count = newState.count
            end sub, scope)

            m.assertEqual(state.count, 5)
            m.assertEqual(scope.props.count, 5)
        end function

        @it("destroy removes observer and deregisters dispatcher")
        function destroy_cleans_up_and_deregisters()
            node = CreateObject("roSGNode", "ContentNode")
            node.addField("rotorSync", "assocarray", true)
            dispatcher = new Rotor.DispatcherCrossThread("toDestroy", node, Rotor.Const.ThreadType.TASK)

            dispatcher.addListener({}, "listener-3", { props: {} })
            dispatcher.destroy()

            m.assertEqual(m.deregisteredId, "toDestroy")
            m.assertEqual(m.removedObservers.Count(), 1)
            m.assertInvalid(dispatcher.stateNode)
        end function

    end class
end namespace
