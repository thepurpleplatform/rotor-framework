{
	"rootDir": "src",
	"outDir": "out",

	"bs_const": {
		"debug": true,
		"unittest": false
	},

	"createPackage": false,
	"compilerOptions": {
		"emitDefinitions": true,
		"sourceMap": true,
		"autoImportComponentScript": true
	},

	"plugins": [
		"@rokucommunity/bslint",
		"rooibos-roku"
	],

	"files": [
		"source/**/*",
		"components/**/*",
		"manifest",
		"assets/**/*",
		"!source/libs/**/*.spec.bs"
	],

	"diagnosticFilters": [
		{
			"src": "**/roku_modules/**/*.*"
		},
		{
			"src": "**/*.spec.*"
		}
	]
}
